# Copy to a private file, replace the placeholders, and chmod 600 that file.
# This trusted file is sourced by Bash when PV_CONFIG points to it.
PV_HOST='YOUR_HTTP_HOST'
PV_PORT=80
PV_HTTPS_HOST='YOUR_HTTPS_HOST'
PV_HTTPS_PORT=443
PV_PATH='/your-download-path'
PV_KEY='YOUR_DOWNLOAD_KEY'
PV_WORK_DIR='/tmp'
PV_OUTPUT='/tmp/downloaded-program'
PV_CONNECT_TIMEOUT=10
PV_HTTP_ATTEMPTS=3
PV_TIMEOUT=300
PV_CA_FILE=''
